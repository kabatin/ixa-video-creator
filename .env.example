# PostgreSQL 16 (infra/docker-compose.yml の postgres サービス)
DATABASE_URL=postgresql://ixa:ixa_dev_password@127.0.0.1:5432/ixa

# Redis (BullMQ ジョブキュー用)
REDIS_URL=redis://127.0.0.1:6379

# 素材・書き出し・波形の置き場（ADR-0041）
# fs … この機械のただのファイル。Finder で開けて Time Machine に乗る（既定）
# s3 … S3 互換のサーバ（MinIO など）。下の S3_* が要る
STORAGE_DRIVER=fs
# 省略すると ~/ixa-video-creator/storage。**絶対パスだけ**（相対や ~ は起動のしかたで場所が変わる）
STORAGE_DIR=
# 素材を画面へ見せる URL の署名の鍵。**32 文字以上**。`openssl rand -hex 32` で作る
# fs のときは必須（無いと素材を 1 つも返せないので、起動時に止まる）
STORAGE_SIGNING_SECRET=
# 素材を見せる URL の宛先。**省略すると下の NEXT_PUBLIC_API_URL と同じ場所**
#（それも無ければ http://127.0.0.1:<API_PORT>）。
# 素材の URL を読むのは画面なので、画面が API を呼ぶ場所と違うとその端末からは何も見えない。
# 画面と別の場所を指したいときだけ書く。
STORAGE_PUBLIC_BASE_URL=

# S3 互換ストレージ (STORAGE_DRIVER=s3 のときだけ使う。ローカルは MinIO)
S3_ENDPOINT=http://127.0.0.1:9000
# LAN の別端末からメディアを見る場合だけ 0.0.0.0 にする（既定は 127.0.0.1）。
# STORAGE_DRIVER=fs では使わない（素材は API が返すので 9000 を開ける必要が無い）。
S3_BIND_HOST=127.0.0.1
S3_REGION=us-east-1
S3_BUCKET=ixa-media
S3_ACCESS_KEY_ID=ixa_minio
S3_SECRET_ACCESS_KEY=ixa_minio_dev_password
S3_FORCE_PATH_STYLE=true

# 外部 API キー（動画生成。Phase 1 は fal.ai を使う。ADR-0013）
FAL_API_KEY=

# 音楽解析サービス（Python / librosa。ADR-0009）
AUDIO_SERVICE_URL=http://127.0.0.1:8100
# 解析サービス（apps/audio）の待ち受けポート。**AUDIO_SERVICE_URL のポートと揃えること。**
# pnpm dev は apps/audio をこの .env で起動する。
AUDIO_PORT=8100
# worker が解析用の音源を書き出す共有ディレクトリ。apps/audio の AUDIO_ROOT と同じ場所を指すこと。
AUDIO_ROOT=/tmp/ixa-audio

# アプリケーションポート
# web の待ち受けポートは apps/web/package.json の dev スクリプトが持つ（3000 固定）。
API_PORT=3001

# Web から見た API の場所（ブラウザに露出するため秘密を入れないこと）
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# 操作対象の Workspace（ULID）。MVP では 1 つだけ存在する想定。
# 未設定だと Web は白画面ではなく設定不足のエラーを表示する。
NEXT_PUBLIC_WORKSPACE_ID=

# ログレベル
LOG_LEVEL=info

# CORS で許可するオリジン（カンマ区切り）
# ブラウザから API を直接叩く経路（署名付き URL の取得など）に必要。
# ワイルドカードは使わず、許可先を明示すること。
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# スタブ映像 Provider をわざと失敗させる割合（0〜1）。既定 0。
# 生成が失敗したときの経路（Shot を生成中から戻す・理由を画面に出す）を確かめるための口。
# これが無いと、その経路は実 Provider を有料で回すまで一度も走らない。
# 1 で全部落ち、0.34 なら 3 本に 1 本ほど落ちて部分失敗も試せる。
# **本番では 0（未設定）のままにする。**
# 反映には dev サーバの再起動が要る（--env-file は起動時にしか読まれない）。
STUB_VIDEO_FAILURE_RATE=0

# スタブ映像 Provider の見かけの単価（USD/秒）。既定 0。
# スタブは本来ただなので見積が必ず 0 になり、予算ガード（checkCostLimits）は
# 構造上ぜったいに発火しない。0 以外にすると、上限で止まることを無料で確かめられる。
# **本番では 0（未設定）のままにする。**
STUB_VIDEO_COST_PER_SEC=0

# 映像生成に実 Provider を使うか。stub | fal。既定は stub（無料）。
# **fal にすると 1 生成ごとに実費が発生する。**
# 鍵の有無では切り替えない（別の理由で FAL_API_KEY を置いた瞬間に課金経路が
# 開くのを避けるため）。fal にしたのに鍵が無ければ起動時に止まる。
VIDEO_PROVIDER=stub

# 手元の生成サーバで動画を作るか。カンマ区切りで複数書ける。既定は none（ADR-0031 / 0040）
#   none            使わない
#   vpipe           vpipe-api の MiniMax H3 Turbo（ADR-0031）
#   wan             wan-api の Wan 2.2 TI2V-5B（ADR-0040）
#   vpipe,wan       両方を選べるようにする（同時には作らない。下記）
# 書いたものが生成欄のモデルと「使う AI」の動画に出る（AUTO には選ばれない）。
# 費用は掛からないが、1 本に数分〜数十分かかり、作っている間はこの機械の GPU とメモリを大きく使う。
# **両方書いても同時には作らない。** どちらも同じ GPU を使うので、worker が 1 本ずつに揃える
# （待っている生成は「順番待ち」と出る）。
# URL やトークンを置いただけでは有効にならない。先にサーバを起動しておくこと。
LOCAL_VIDEO_GENERATOR=none
# vpipe-api の場所。既定はこのマシンだけ（127.0.0.1）。
VPIPE_API_URL=http://127.0.0.1:8765
# vpipe-api のトークン（サーバの VPIPE_API_TOKEN と同じ値）。このマシンのサーバなら空でよい。
# **このマシンの外を指すならトークン必須**（無いと起動時に止まる）。
VPIPE_API_TOKEN=
# wan-api の場所。既定はこのマシンだけ（127.0.0.1。vpipe-api とポートを分ける）。
WAN_API_URL=http://127.0.0.1:8766
# wan-api のトークン（サーバの合言葉と同じ値）。このマシンのサーバなら空でよい。
# **このマシンの外を指すならトークン必須**（無いと起動時に止まる）。
WAN_API_TOKEN=

# ナレーションの声と、録音の文字起こし（ADR-0038）。どれを使うかはワークベンチの「使う AI…」で選ぶ。
# Mac の声（say）と whisper.cpp は無料でこの Mac の中で動く。Gemini・ElevenLabs は原稿が外に出る（ElevenLabs は有料）。
# **鍵を置いただけでは選べない。** 使ってよい外部 API を AUDIO_API_PROVIDERS にカンマ区切りで書く（gemini_api,elevenlabs）。
# 書いたのに鍵が無ければ起動時に止まる。
AUDIO_API_PROVIDERS=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Gemini を無料枠で使うか（free | paid）。費用の見積もりに使う（free なら 0）。
# 無料枠では送った原稿が Google の製品改善に使われ、人が見ることがある。
GEMINI_API_BILLING=free
# ElevenLabs の 1000 字あたりの単価（USD）。プランで違う。既定は従量課金の 0.08。
ELEVENLABS_USD_PER_1K_CHARS=0.08
# whisper.cpp のモデルのファイル（絶対パス。例: /Users/you/models/ggml-large-v3-turbo.bin）。
# whisper-cli は `brew install whisper-cpp` で入る。空なら whisper.cpp は選べない。
WHISPER_CPP_MODEL=

# 絵コンテの下書き（「絵コンテの案…」）を誰が書くか。stub | claude_cli
# stub は仮の文を返すだけで費用は発生しない。
# **claude_cli にすると手元の Claude Code CLI を呼び、契約の利用枠を使う。**
STORYBOARD_DRAFTER=stub

# 絵コンテの画像（Shot の最初のフレーム）を誰が作るか。stub | codex_cli（ADR-0029）
# stub は仮の絵（色の面）を作るだけで費用は発生しない。
# **codex_cli にすると手元の Codex CLI を呼び、契約の利用枠を使う**（1 枚 70 秒ほど）。
# 使う前に `codex` をインストールしてログインしておくこと（worker と同じ PATH で動く）。
IMAGE_PROVIDER=stub

# 書き出した動画を置くフォルダ（ADR-0036）。空なら ~/Movies/ixa-video-creator。
# **絶対パス（/ で始まる）で書く。** 書き出し画面の「フォルダを開く」で、ここへ入れてから Finder で開く。
RENDER_EXPORT_DIR=

# API の待ち受けアドレス。既定は 127.0.0.1（このマシンからのみ）。
# **この API には認証が無い。** 0.0.0.0 にすると同じネットワークの誰でも
# Project を消せて、課金される生成を投げられる。
# LAN から触るときだけ明示的に変え、終わったら戻すこと。
API_HOST=127.0.0.1
