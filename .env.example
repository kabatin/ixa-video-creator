# ixa の設定（最初に要るものだけ）。pnpm ixa setup がこのファイルを .env に写し、空欄を埋める。
# 既定は課金しない設定。ここに無い設定は書かなければ既定で動く。
# **ほかの設定は全部 .env.full.example にある**（説明つき）。変えたい行だけ .env へ写して値を書く。

# PostgreSQL 16 (infra/docker-compose.yml の postgres サービス)
DATABASE_URL=postgresql://ixa:ixa_dev_password@127.0.0.1:5432/ixa
# Redis (BullMQ ジョブキュー用)
REDIS_URL=redis://127.0.0.1:6379
# 同じ Mac で 2 つ目の clone を動かすときは .env.full.example の IXA_COMPOSE_* を見る（INSTALL.md「2 つ目の clone」）。

# 素材・書き出し・波形の置き場（ADR-0041）。fs … この機械のただのファイル（既定）
STORAGE_DRIVER=fs
# 省略すると ~/ixa-video-creator/storage。**絶対パスだけ**（相対や ~ は起動のしかたで場所が変わる）
STORAGE_DIR=
# 素材を画面へ見せる URL の署名の鍵。**32 文字以上**。空なら pnpm ixa setup が作って入れる
STORAGE_SIGNING_SECRET=

# API の待ち受けポートと、画面から見た API の場所。**ポートを替えたら両方揃える。**
# web の待ち受けポートは 3000 固定（apps/web/package.json）。
API_PORT=3001
# ブラウザに露出するため秘密を入れないこと
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# 操作対象の Workspace（ULID）。空なら pnpm ixa setup が作って入れる
NEXT_PUBLIC_WORKSPACE_ID=

# 音楽解析サービス（apps/audio。ADR-0009）。**URL とポートを揃えること。**
AUDIO_SERVICE_URL=http://127.0.0.1:8100
AUDIO_PORT=8100
# worker が解析用の音源を書き出し、apps/audio が読む共有ディレクトリ。**両方が同じ場所を読むので消さない**
# （書かないと worker と apps/audio の既定が食い違い、曲の解析が通らない）。
AUDIO_ROOT=/tmp/ixa-audio

# 誰が作るか。既定はどれもスタブ（無料）。実物にすると費用や契約の利用枠を使う（説明は .env.full.example）。
# 映像: stub | fal（fal は 1 生成ごとに実費。FAL_API_KEY が要る）
VIDEO_PROVIDER=stub
# 絵コンテの画像: stub | codex_cli（手元の Codex CLI。契約の利用枠を使う）
IMAGE_PROVIDER=stub
# 絵コンテの下書き: stub | claude_cli（手元の Claude Code CLI。契約の利用枠を使う）
STORYBOARD_DRAFTER=stub
