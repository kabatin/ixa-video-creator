  },
  "dependencies": {
    "@ixa/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
